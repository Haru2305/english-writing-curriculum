---
import { toLearnerText as userText } from "../lib/learner-text.js";

const { sections = [], answer = false } = Astro.props;

function isCollapsibleSubgroup(title) {
  return userText(title) === "Pre-solveの整理と本文での使い方";
}

function importanceClass(title) {
  if (["Reading", "Questions", "Claim Check", "Short Output", "Mini Writing", "Writing Task", "Data Table", "Reading answers", "答えだけ", "モデル答案", "Model answer", "Model output", "Model short output"].includes(title)) {
    return "importance-primary";
  }
  if (
    ["Pre-solve Nuance", "P3 Strategy", "Unknown-concept strategy", "Language Focus — 使い分け確認", "本文の骨格", "Why this word?", "Task fulfillment", "別解"].includes(title)
    || /^解説補強｜/.test(title)
  ) {
    return "importance-secondary";
  }
  return "importance-tertiary";
}

function blockClass(lines, sectionTitle) {
  const first = lines[0] ?? "";
  if (/^Q\d+[.｜]/.test(first)) return "question-block";
  if (sectionTitle === "Reading") return "reading-block";
  if (["今日の狙い", "Self-check", "自己評価"].includes(sectionTitle)) return "list-block";
  if (/^\d+[.．]\s/.test(first)) return "numbered-block";
  return "";
}

function sectionClass(title) {
  return userText(title) === "答えだけ" ? "answer-key-group" : "";
}

function lineClass(line, sectionTitle = "") {
  if (userText(sectionTitle) === "答えだけ") {
    if (/^Q\d+[.｜:：]/.test(line)) return "answer-key-line answer-key-question";
    if (/^(?:Nuance Check|Guided Writing)\s*[｜:：]/i.test(line)) return "answer-key-line answer-key-task";
    return "answer-key-line";
  }
  if (/^Q\d+[.｜:：]/.test(line)) return "question";
  if (/^[A-D][.．]\s/.test(line)) return "choice";
  if (/^\d+[.．]\s/.test(line)) return "numbered-item";
  if (/^differ (from|in) \+/.test(line)) return "key-definition";
  if (/^-\s*(Answer|Reason|Mechanism|Support|Qualification|Return)\s*:/.test(line)) return "structure-line";
  if (/^[-→]/.test(line)) return "flow-line";
  return "";
}
---

{sections.map((section) => (
  <section class={"content-group " + importanceClass(section.title) + " " + sectionClass(section.title) + " " + (answer ? "answer-group" : "")}>
    {section.title && <h2 class="content-group-title">{userText(section.title)}</h2>}
    <div class="content-group-body">
      {section.units.map((unit) =>
        unit.type === "subgroup" ? (
          isCollapsibleSubgroup(unit.title) ? (
            <details class="micro-group collapsible-micro-group">
              <summary class="micro-group-title collapsible-micro-group-title">
                {userText(unit.title)}
              </summary>
              <div class="micro-group-body">
                {unit.blocks.map((block) => (
                  <div class={"micro-block " + blockClass(block.lines, section.title)}>
                    {block.lines.map((line) => (
                      <p class={"lesson-line " + lineClass(line, section.title)}>{userText(line)}</p>
                    ))}
                  </div>
                ))}
              </div>
            </details>
          ) : (
            <section class="micro-group">
              <h3 class="micro-group-title">{userText(unit.title)}</h3>
              <div class="micro-group-body">
                {unit.blocks.map((block) => (
                  <div class={"micro-block " + blockClass(block.lines, section.title)}>
                    {block.lines.map((line) => (
                      <p class={"lesson-line " + lineClass(line, section.title)}>{userText(line)}</p>
                    ))}
                  </div>
                ))}
              </div>
            </section>
          )
        ) : (
          <div class={"micro-block " + blockClass(unit.lines, section.title)}>
            {unit.lines.map((line) => (
              <p class={"lesson-line " + lineClass(line, section.title)}>{userText(line)}</p>
            ))}
          </div>
        )
      )}
    </div>
  </section>
))}
