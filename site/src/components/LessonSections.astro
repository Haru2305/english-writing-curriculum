---
import { toLearnerText as userText, toLearnerLabel as userLabel } from "../lib/learner-text.js";
import { reviewPresentation } from "../lib/review-presentation.js";

const { sections = [], answer = false } = Astro.props;

function isCollapsibleSubgroup(title) {
  return userText(title) === "Pre-solveの整理と本文での使い方";
}

function importanceClass(title) {
  if (["Reading", "Questions", "Claim Check", "Short Output", "Mini Writing", "Writing Task", "Data Table", "Reading answers", "答えだけ", "解答一覧", "モデル答案", "Model answer", "Model output", "Model short output"].includes(title)) {
    return "importance-primary";
  }
  if (
    ["Pre-solve Nuance", "P3 Strategy", "Unknown-concept strategy", "Language Focus — 使い分け確認", "本文の骨格", "Why this word?", "Task fulfillment", "別解"].includes(title)
    || /^解説補強｜/.test(title)
  ) {
    return "importance-secondary";
  }
  return "importance-tertiary";
}

function blockClass(lines, sectionTitle) {
  const first = lines[0] ?? "";
  if (/^Q\d+[.｜]/.test(first)) return "question-block";
  if (sectionTitle === "Reading") return "reading-block";
  if (["今日の狙い", "Self-check", "自己評価"].includes(sectionTitle)) return "list-block";
  if (/^\d+[.．]\s/.test(first)) return "numbered-block";
  return "";
}

function isAnswerList(title) {
  return ["答えだけ", "解答一覧"].includes(userText(title));
}

function sectionClass(title, answerMode = false) {
  if (isAnswerList(title)) return "answer-key-group";
  if (!answerMode) return "";

  const presentation = reviewPresentation(title);
  return "review-" + presentation.kind + "-group";
}

function answerListRow(line) {
  const text = userText(line);
  const match = text.match(/^(.+?)\s*[｜]\s*(.+)$/);
  if (!match) return { label: "", answer: text };
  return { label: match[1].trim(), answer: match[2].trim() };
}

function answerValueClass(answer) {
  return "answer-list-value" + (answer.length <= 24 ? " answer-list-value-short" : "");
}

function lineClass(line, sectionTitle = "") {
  if (isAnswerList(sectionTitle)) {
    if (/^Q\d+[.｜:：]/.test(line)) return "answer-key-line answer-key-question";
    if (/^(?:Nuance Check|Guided Writing)\s*[｜:：]/i.test(line)) return "answer-key-line answer-key-task";
    return "answer-key-line";
  }
  if (/^Q\d+[.｜:：]/.test(line)) return "question";
  if (/^[A-D][.．]\s/.test(line)) return "choice";
  if (/^\d+[.．]\s/.test(line)) return "numbered-item";
  if (/^differ (from|in) \+/.test(line)) return "key-definition";
  if (/^-\s*(Answer|Reason|Mechanism|Support|Qualification|Return)\s*:/.test(line)) return "structure-line";
  if (/^[-→]/.test(line)) return "flow-line";
  return "";
}
---

{sections.map((section) => {
  const reviewMeta = answer ? reviewPresentation(section.title) : null;
  return (
  <section class={"content-group " + importanceClass(section.title) + " " + sectionClass(section.title, answer) + " " + (answer ? "answer-group" : "")}>
    {answer && ["learning", "writing"].includes(reviewMeta?.kind) && reviewMeta?.label && (
      <span class="review-kind-label">{reviewMeta.label}</span>
    )}
    {section.title && <h2 class="content-group-title">{userLabel(section.title)}</h2>}
    <div class="content-group-body">
      {section.units.map((unit) =>
        unit.type === "subgroup" ? (
          isCollapsibleSubgroup(unit.title) ? (
            <details class="micro-group collapsible-micro-group">
              <summary class="micro-group-title collapsible-micro-group-title">
                {userLabel(unit.title)}
              </summary>
              <div class="micro-group-body">
                {unit.blocks.map((block) => (
                  <div class={"micro-block " + blockClass(block.lines, section.title)}>
                    {block.lines.map((line) => (
                      <p class={"lesson-line " + lineClass(line, section.title)}>{userText(line)}</p>
                    ))}
                  </div>
                ))}
              </div>
            </details>
          ) : (
            <section class="micro-group">
              <h3 class="micro-group-title">{userLabel(unit.title)}</h3>
              <div class="micro-group-body">
                {unit.blocks.map((block) => (
                  <div class={"micro-block " + blockClass(block.lines, section.title)}>
                    {block.lines.map((line) => (
                      <p class={"lesson-line " + lineClass(line, section.title)}>{userText(line)}</p>
                    ))}
                  </div>
                ))}
              </div>
            </section>
          )
        ) : isAnswerList(section.title) ? (
          <div class="answer-list" role="list" aria-label="解答一覧">
            {unit.lines.map((line) => {
              const row = answerListRow(line);
              return (
                <div class="answer-list-row" role="listitem">
                  <span class="answer-list-label">{row.label}</span>
                  <span class={answerValueClass(row.answer)}>{row.answer}</span>
                </div>
              );
            })}
          </div>
        ) : (
          <div class={"micro-block " + blockClass(unit.lines, section.title)}>
            {unit.lines.map((line) => (
              <p class={"lesson-line " + lineClass(line, section.title)}>{userText(line)}</p>
            ))}
          </div>
        )
      )}
    </div>
  </section>
  );
})}
