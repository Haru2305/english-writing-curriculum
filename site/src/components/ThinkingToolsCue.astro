---
import { toolsForLesson } from "../data/thinking-tools.js";

const { lessonId } = Astro.props;
const tools = toolsForLesson(lessonId);
---

{tools.length > 0 && (
  <aside class="thinking-tool-cue" aria-label="今回の問題で使う考え方">
    <div class="thinking-tool-cue-head">
      <span class="cue-label">今回の考え方</span>
      <a href="/thinking-tools/">考え方を見る</a>
    </div>
    <div class="thinking-tool-cue-list">
      {tools.map((tool) => (
        <a class="thinking-tool-chip" href={"/thinking-tools/#" + tool.id}>
          <strong>{tool.label}</strong>
          <small>{tool.english}</small>
        </a>
      ))}
    </div>
  </aside>
)}
