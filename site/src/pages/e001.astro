---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";

const sourcePath = path.resolve(process.cwd(), "../bundles/B001/E001.md");
const raw = fs.readFileSync(sourcePath, "utf8").replace(/\r\n/g, "\n");

const marker = "解答・解説・自己修正";
const markerIndex = raw.indexOf(marker);

if (markerIndex < 0) {
  throw new Error("E001 answer marker was not found.");
}

const beforeMarker = raw.slice(0, markerIndex);
const afterMarker = raw.slice(markerIndex + marker.length);

const problemText = beforeMarker.replace(/_+\s*$/m, "").trim();
const answerText = afterMarker.trim();

const problemLines = problemText.split("\n").map((line) => line.trim()).filter(Boolean);
const answerLines = answerText.split("\n").map((line) => line.trim()).filter(Boolean);

const titleLine = problemLines.shift() ?? "E001";
const metaLine = problemLines.shift() ?? "";
const title = titleLine.replace(/^E001｜/, "");
const pageTitle = "E001｜" + title;

const sectionNames = new Set([
  "今日の狙い",
  "時間配分",
  "Pre-solve Nuance",
  "Gloss / Reading support",
  "Reading",
  "Questions",
  "Language Focus — 使い分け確認",
  "Mini Writing",
  "Self-check",
  "まず確認",
  "Reading answers",
  "本文の骨格",
  "Why this word?",
  "Task fulfillment",
  "自己修正",
  "自己評価",
  "任意Escalation",
  "モデル答案",
  "別解",
  "Correct",
  "Natural",
  "Precise"
]);

function clean(line) {
  return line.replace(/^#{2,3}\s+/, "").replace(/\*\*/g, "");
}

function isGroupHeading(line) {
  return line.startsWith("## ")
    || sectionNames.has(line)
    || /^解説補強｜/.test(line);
}

function lineClass(line) {
  if (line.startsWith("### ")) return "subsection";
  if (/^(LEXG\d+｜|G\d+｜|A\d+｜)/.test(line)) return "subsection";
  if (/^Q\d+[.｜]/.test(line)) return "question";
  if (/^[A-D][.．]\s/.test(line)) return "choice";
  return "";
}

function groupLines(lines) {
  const groups = [];
  let current = { title: "", lines: [] };

  for (const line of lines) {
    if (/^_+$/.test(line)) {
      continue;
    }

    if (isGroupHeading(line)) {
      if (current.title || current.lines.length) {
        groups.push(current);
      }
      current = { title: clean(line), lines: [] };
      continue;
    }

    current.lines.push(line);
  }

  if (current.title || current.lines.length) {
    groups.push(current);
  }

  return groups;
}

const problemGroups = groupLines(problemLines);
const answerGroups = groupLines(answerLines);
---

<BaseLayout title={pageTitle} description="E001 スマホ閲覧プロトタイプ">
  <article>
    <header class="lesson-header">
      <p class="lesson-id">E001 · B001</p>
      <h1 class="lesson-title">{title}</h1>
      <p class="lesson-meta">{metaLine}</p>
    </header>

    <section class="lesson-body content-stack" aria-label="問題">
      {problemGroups.map((group) => (
        <section class="content-group">
          {group.title && <h2 class="content-group-title">{group.title}</h2>}
          <div class="content-group-body">
            {group.lines.map((line) => (
              <p class={"lesson-line " + lineClass(line)}>{clean(line)}</p>
            ))}
          </div>
        </section>
      ))}
    </section>

    <details class="answer-details">
      <summary>解答・解説を見る</summary>
      <section class="answer-content content-stack" aria-label="解答・解説">
        {answerGroups.map((group) => (
          <section class="content-group answer-group">
            {group.title && <h2 class="content-group-title">{group.title}</h2>}
            <div class="content-group-body">
              {group.lines.map((line) => (
                <p class={"lesson-line " + lineClass(line)}>{clean(line)}</p>
              ))}
            </div>
          </section>
        ))}
      </section>
    </details>

    <nav class="nav-row" aria-label="教材ナビゲーション">
      <a class="nav-link" href="/">一覧へ戻る</a>
    </nav>
  </article>
</BaseLayout>
