---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import LessonSections from "../components/LessonSections.astro";

const sourcePath = path.resolve(process.cwd(), "../bundles/B001/E001.md");
const raw = fs.readFileSync(sourcePath, "utf8").replace(/\r\n/g, "\n");

const marker = "解答・解説・自己修正";
const markerIndex = raw.indexOf(marker);

if (markerIndex < 0) {
  throw new Error("E001 answer marker was not found.");
}

const beforeMarker = raw.slice(0, markerIndex);
const afterMarker = raw.slice(markerIndex + marker.length);

const sectionNames = new Set([
  "今日の狙い",
  "時間配分",
  "Pre-solve Nuance",
  "Gloss / Reading support",
  "Reading",
  "Questions",
  "Language Focus — 使い分け確認",
  "Mini Writing",
  "Self-check",
  "まず確認",
  "Reading answers",
  "本文の骨格",
  "Why this word?",
  "Task fulfillment",
  "自己修正",
  "自己評価",
  "任意Escalation",
  "モデル答案",
  "別解",
  "Correct",
  "Natural",
  "Precise"
]);

function clean(line) {
  return line.replace(/^#{2,3}\s+/, "").replace(/\*\*/g, "");
}

function isSectionHeading(line) {
  return line.startsWith("## ")
    || sectionNames.has(line)
    || /^解説補強｜/.test(line);
}

function isSubheading(line) {
  return line.startsWith("### ")
    || /^(LEXG\d+｜|G\d+｜|A\d+｜)/.test(line);
}

function takeHeader(text) {
  const lines = text.split("\n");
  const nonEmpty = lines
    .map((line, index) => ({ line: line.trim(), index }))
    .filter((item) => item.line);

  const titleItem = nonEmpty[0] ?? { line: "E001", index: 0 };
  const metaItem = nonEmpty[1] ?? { line: "", index: titleItem.index };
  return {
    titleLine: titleItem.line,
    metaLine: metaItem.line,
    bodyLines: lines.slice(metaItem.index + 1)
  };
}

function parseSections(lines) {
  const sections = [];
  let section = { title: "", units: [] };
  let subgroup = null;
  let block = [];

  const flushBlock = () => {
    if (!block.length) return;
    const unit = { type: "block", lines: block.map(clean) };
    if (subgroup) subgroup.blocks.push(unit);
    else section.units.push(unit);
    block = [];
  };

  const flushSubgroup = () => {
    flushBlock();
    if (!subgroup) return;
    section.units.push(subgroup);
    subgroup = null;
  };

  const flushSection = () => {
    flushSubgroup();
    if (section.title || section.units.length) sections.push(section);
    section = { title: "", units: [] };
  };

  for (const rawLine of lines) {
    const line = rawLine.trim();

    if (!line || /^_+$/.test(line)) {
      flushBlock();
      continue;
    }

    if (isSectionHeading(line)) {
      flushSection();
      section.title = clean(line);
      continue;
    }

    if (isSubheading(line)) {
      flushSubgroup();
      subgroup = { type: "subgroup", title: clean(line), blocks: [] };
      continue;
    }

    block.push(line);
  }

  flushSection();
  return sections;
}

function findSection(sections, title) {
  return sections.find((section) => section.title === title);
}

function pickSections(sections, titles) {
  return titles.map((title) => findSection(sections, title)).filter(Boolean);
}

function withoutTitle(section) {
  return section ? { ...section, title: "" } : null;
}

function splitReadingAnswers(section) {
  if (!section) return { key: null, detail: null };

  const keyUnits = [];
  const detailUnits = [];

  function splitQuestionChunks(lines) {
    const chunks = [];
    let current = [];

    for (const line of lines) {
      if (/^Q\d+[.｜]/.test(line) && current.length) {
        chunks.push(current);
        current = [];
      }
      current.push(line);
    }

    if (current.length) chunks.push(current);
    return chunks;
  }

  for (const unit of section.units) {
    if (unit.type !== "block") {
      detailUnits.push(unit);
      continue;
    }

    const chunks = splitQuestionChunks(unit.lines);

    for (const lines of chunks) {
      const first = lines[0] ?? "";

      if (!/^Q\d+[.｜]/.test(first)) {
        detailUnits.push({ type: "block", lines });
        continue;
      }

      const keyLineCount = /^Q3[.｜]/.test(first) && lines.length > 1 ? 2 : 1;
      keyUnits.push({ type: "block", lines: lines.slice(0, keyLineCount) });

      const rest = lines.slice(keyLineCount);
      if (rest.length) {
        detailUnits.push({
          type: "block",
          lines: [first, ...rest]
        });
      }
    }
  }

  return {
    key: { title: "Reading answers", units: keyUnits },
    detail: { title: "Reading answers｜解説", units: detailUnits }
  };
}

function languageAnswerKey(section) {
  if (!section) return null;
  const lines = [];

  for (const unit of section.units) {
    if (unit.type !== "subgroup" || !/^LEXG\d+｜/.test(unit.title)) continue;
    for (const block of unit.blocks) {
      for (const line of block.lines) {
        if (/^[1-4][.．]\s+(from|in)$/.test(line)) lines.push(line);
      }
    }
  }

  return lines.length
    ? { title: "Language Focus｜答え", units: [{ type: "block", lines }] }
    : null;
}

function splitSupplement(section) {
  if (!section) return { reasoning: null, takeaway: null };

  const reasoningUnits = [];
  const takeawayUnits = [];

  for (const unit of section.units) {
    if (unit.type === "subgroup" && unit.title === "次の問題に持っていくもの") {
      takeawayUnits.push(unit);
    } else {
      reasoningUnits.push(unit);
    }
  }

  return {
    reasoning: reasoningUnits.length ? { ...section, units: reasoningUnits } : null,
    takeaway: takeawayUnits.length
      ? { title: "次の問題に持っていくもの", units: takeawayUnits }
      : null
  };
}

const problemHeader = takeHeader(beforeMarker.replace(/_+\s*$/m, "").trimEnd());
const answerLines = afterMarker.trim().split("\n");

const title = problemHeader.titleLine.replace(/^E001｜/, "");
const pageTitle = "E001｜" + title;
const timeMatch = problemHeader.metaLine.match(/目安\s*[^｜]+/);
const learnerMeta = timeMatch?.[0]?.trim() ?? "";
const problemSections = parseSections(problemHeader.bodyLines);
const answerSections = parseSections(answerLines);

function flatSectionLines(section) {
  if (!section) return [];
  const lines = [];
  for (const unit of section.units) {
    if (unit.type === "subgroup") {
      for (const block of unit.blocks) lines.push(...block.lines);
    } else {
      lines.push(...unit.lines);
    }
  }
  return lines;
}

const timeSection = findSection(problemSections, "時間配分");
const timeText = flatSectionLines(timeSection)[0] ?? "";
const glossSection = findSection(problemSections, "Gloss / Reading support");
const selfCheckSection = findSection(problemSections, "Self-check");

const lessonKeys = [
  { label: "表現", value: "differ from / differ in" },
  { label: "見るポイント", value: "比較対象か、相違点か" },
  { label: "考え方", value: "医療アクセスを複数要因で見る" }
];

const writeMap = ["Answer", "Reason", "Mechanism", "Support"];

function readingParagraphs(section) {
  if (!section) return [];
  return section.units
    .filter((unit) => unit.type === "block")
    .map((unit) => unit.lines.join(" "))
    .filter(Boolean);
}

const readingReference = readingParagraphs(findSection(problemSections, "Reading"));
const referenceShortcuts = [
  { label: "全文", paragraphs: "all" },
  { label: "Q1", paragraphs: "all" },
  { label: "Q2", paragraphs: "3" },
  { label: "Q3", paragraphs: "2,3,4" },
  { label: "differ in", paragraphs: "4" }
];

const problemStages = [
  {
    kind: "setup",
    kicker: "START",
    title: "解く前に",
    sections: [
      withoutTitle(findSection(problemSections, "今日の狙い")),
      findSection(problemSections, "Pre-solve Nuance")
    ].filter(Boolean)
  },
  {
    kind: "core challenge",
    kicker: "CHALLENGE",
    title: "Reading & Questions",
    sections: [
      findSection(problemSections, "Reading"),
      findSection(problemSections, "Questions"),
      findSection(problemSections, "Language Focus — 使い分け確認")
    ].filter(Boolean)
  },
  {
    kind: "core writing",
    kicker: "WRITE",
    title: "Mini Writing",
    sections: [withoutTitle(findSection(problemSections, "Mini Writing"))].filter(Boolean)
  }
];

const readingSplit = splitReadingAnswers(findSection(answerSections, "Reading answers"));
const bodyStructure = findSection(answerSections, "本文の骨格");
const languageKey = languageAnswerKey(bodyStructure);
const supplement = splitSupplement(
  answerSections.find((section) => /^解説補強｜/.test(section.title))
);

const answerKeySections = [
  readingSplit.key,
  languageKey,
  findSection(answerSections, "モデル答案"),
  findSection(answerSections, "別解")
].filter(Boolean);

const whySections = [
  readingSplit.detail,
  bodyStructure,
  findSection(answerSections, "Why this word?")
].filter((section) => section && section.units.length);

const writingReasonSections = [
  findSection(answerSections, "Task fulfillment"),
  supplement.reasoning
].filter(Boolean);

const reviewCoreSections = [
  findSection(answerSections, "自己修正"),
  findSection(answerSections, "Correct"),
  findSection(answerSections, "Natural"),
  findSection(answerSections, "Precise"),
  supplement.takeaway
].filter(Boolean);

const reviewExtraSections = [
  findSection(answerSections, "自己評価"),
  findSection(answerSections, "任意Escalation")
].filter(Boolean);

const answerNotice = findSection(answerSections, "まず確認");
---

<BaseLayout title={pageTitle} description="E001 スマホ閲覧プロトタイプ">
  <article>
    <header class="lesson-header">
      <div class="series-mark" aria-label="シリーズと教材番号">
        <span>自由英作文</span>
        <span aria-hidden="true">/</span>
        <strong>E001</strong>
      </div>
      <h1 class="lesson-title">{title}</h1>
      {learnerMeta && <p class="lesson-meta">{learnerMeta}</p>}
    </header>

    <section class="lesson-flow" aria-label="問題">
      {problemStages.map((stage, index) => (
        <section class={"flow-stage flow-stage-" + stage.kind}>
          <header class="flow-stage-header">
            <span class="flow-kicker">{stage.kicker}</span>
            <h2>{stage.title}</h2>
            {index === 0 && timeText && <p class="flow-meta">{timeText}</p>}
          </header>

          <div class="flow-stage-body">
            {index === 0 && (
              <section class="lesson-keys" aria-label="今回の重要ポイント">
                <span class="cue-label">KEYS</span>
                <div class="lesson-keys-list">
                  {lessonKeys.map((item) => (
                    <div class="lesson-key">
                      <small>{item.label}</small>
                      <strong>{item.value}</strong>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {stage.kind.includes("writing") && (
              <section class="write-map" aria-label="答案の構成">
                <span class="cue-label">WRITE MAP</span>
                <div class="write-map-flow">
                  {writeMap.map((item, itemIndex) => (
                    <>
                      <span class="write-map-item">{item}</span>
                      {itemIndex < writeMap.length - 1 && <span class="write-map-arrow" aria-hidden="true">→</span>}
                    </>
                  ))}
                </div>
              </section>
            )}

            <LessonSections sections={stage.sections} />

            {index === 0 && glossSection && (
              <details class="support-details">
                <summary>語句・Reading support</summary>
                <div class="support-details-body">
                  <LessonSections sections={[withoutTitle(glossSection)]} />
                </div>
              </details>
            )}

            {stage.kind.includes("writing") && selfCheckSection && (
              <details class="support-details">
                <summary>書き終わったら確認</summary>
                <div class="support-details-body">
                  <LessonSections sections={[withoutTitle(selfCheckSection)]} />
                </div>
              </details>
            )}
          </div>
        </section>
      ))}
    </section>

    <details class="answer-details">
      <summary class="review-trigger">
        <span>REVIEW</span>
        <strong>解答・解説を見る</strong>
      </summary>

      <div class="review-workspace">
        <aside class="review-reference-pane" aria-label="本文参照">
          <div class="reference-pane-sticky">
            <span class="cue-label">REFERENCE</span>
            <h2>Reading</h2>
            <div class="reference-reading">
              {readingReference.map((paragraph, index) => (
                <p data-reference-paragraph={index + 1}>
                  <span class="reference-paragraph-number">{index + 1}</span>
                  {paragraph}
                </p>
              ))}
            </div>
          </div>
        </aside>

        <div class="answer-flow">
          <nav class="reference-dock" aria-label="本文参照ショートカット">
            <span>本文参照</span>
            <div>
              {referenceShortcuts.map((item) => (
                <button
                  type="button"
                  class="reference-button"
                  data-reference-paragraphs={item.paragraphs}
                  data-reference-label={item.label}
                >
                  {item.label}
                </button>
              ))}
            </div>
          </nav>

          {answerNotice && (
            <p class="answer-notice-text">{flatSectionLines(answerNotice).join(" ")}</p>
          )}

          <details class="answer-stage answer-stage-primary" open>
            <summary>
              <strong>答え</strong>
              <small>正答とモデル答案</small>
            </summary>
            <div class="answer-stage-body">
              <LessonSections sections={answerKeySections} answer />
            </div>
          </details>

          <details class="answer-stage answer-stage-secondary">
            <summary>
              <strong>考え方</strong>
              <small>なぜそうなるか・どう考えて書くか</small>
            </summary>
            <div class="answer-stage-body">
              <LessonSections sections={[...whySections, ...writingReasonSections]} answer />
            </div>
          </details>

          <details class="answer-stage answer-stage-tertiary">
            <summary>
              <strong>持ち帰り</strong>
              <small>自己修正と次の問題への再利用</small>
            </summary>
            <div class="answer-stage-body">
              <LessonSections sections={reviewCoreSections} answer />

              {reviewExtraSections.length > 0 && (
                <details class="support-details review-extra">
                  <summary>自己評価・相談の目安</summary>
                  <div class="support-details-body">
                    <LessonSections sections={reviewExtraSections} answer />
                  </div>
                </details>
              )}
            </div>
          </details>
        </div>
      </div>
    </details>

    <dialog class="reference-dialog" id="reference-dialog" aria-labelledby="reference-dialog-title">
      <div class="reference-dialog-sheet">
        <header class="reference-dialog-header">
          <div>
            <span class="cue-label">REFERENCE</span>
            <h2 id="reference-dialog-title">本文</h2>
          </div>
          <button type="button" class="reference-dialog-close" data-reference-close aria-label="本文参照を閉じる">閉じる</button>
        </header>
        <div class="reference-dialog-reading">
          {readingReference.map((paragraph, index) => (
            <p data-dialog-paragraph={index + 1}>
              <span class="reference-paragraph-number">{index + 1}</span>
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    </dialog>

    <script is:inline>
      const dialog = document.getElementById("reference-dialog");
      const dialogTitle = document.getElementById("reference-dialog-title");
      const desktopPane = document.querySelector(".review-reference-pane");
      const desktopParagraphs = [...document.querySelectorAll("[data-reference-paragraph]")];
      const dialogParagraphs = [...document.querySelectorAll("[data-dialog-paragraph]")];
      const desktopQuery = window.matchMedia("(min-width: 960px)");

      function selectedParagraphs(value) {
        if (value === "all") return [];
        return value.split(",").map(Number).filter(Boolean);
      }

      function updateDesktopReference(selected) {
        desktopParagraphs.forEach((paragraph) => {
          const number = Number(paragraph.dataset.referenceParagraph);
          paragraph.classList.toggle("reference-target", selected.includes(number));
        });

        if (!desktopPane) return;

        const firstTarget = selected.length
          ? desktopPane.querySelector('[data-reference-paragraph="' + selected[0] + '"]')
          : desktopPane.querySelector(".reference-reading");

        firstTarget?.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }

      function openMobileReference(selected, label) {
        if (!dialog) return;
        dialogTitle.textContent = label === "全文" ? "本文全文" : label + " の本文";

        dialogParagraphs.forEach((paragraph) => {
          const number = Number(paragraph.dataset.dialogParagraph);
          const show = selected.length === 0 || selected.includes(number);
          paragraph.hidden = !show;
          paragraph.classList.toggle("reference-target", selected.includes(number));
        });

        if (!dialog.open) dialog.showModal();
      }

      document.querySelectorAll("[data-reference-paragraphs]").forEach((button) => {
        button.addEventListener("click", () => {
          const selected = selectedParagraphs(button.dataset.referenceParagraphs || "all");
          const label = button.dataset.referenceLabel || "本文";

          if (desktopQuery.matches) {
            updateDesktopReference(selected);
          } else {
            openMobileReference(selected, label);
          }
        });
      });

      document.querySelector("[data-reference-close]")?.addEventListener("click", () => {
        dialog?.close();
      });

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>

    <nav class="nav-row" aria-label="教材ナビゲーション">
      <a class="nav-link" href="/">一覧へ戻る</a>
    </nav>
  </article>
</BaseLayout>
