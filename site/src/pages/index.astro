---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLessonCatalog } from "../lib/lesson-catalog.js";
import { P1_ACCELERATED_ROUTE } from "../data/p1-accelerated-route.js";
import { P2_ACCELERATED_ROUTE } from "../data/p2-accelerated-route.js";
import { P3_ACCELERATED_ROUTE } from "../data/p3-accelerated-route.js";

const lessons = getLessonCatalog();
const representatives = lessons.filter((lesson) => lesson.representative);
const lessonById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
const acceleratedP1 = P1_ACCELERATED_ROUTE.map((item, index) => ({
  ...item,
  step: index + 1,
  lesson: lessonById.get(item.id)
})).filter((item) => item.lesson);
const acceleratedP2 = P2_ACCELERATED_ROUTE.map((item, index) => ({
  ...item,
  step: index + 1,
  lesson: lessonById.get(item.id)
})).filter((item) => item.lesson);
const acceleratedP3 = P3_ACCELERATED_ROUTE.map((item, index) => ({
  ...item,
  step: index + 1,
  lesson: lessonById.get(item.id)
})).filter((item) => item.lesson);
const bundles = [...new Set(lessons.map((lesson) => lesson.bundle))].map((bundle) => ({
  bundle,
  lessons: lessons.filter((lesson) => lesson.bundle === bundle)
}));
---

<BaseLayout title="英語教材｜スマホビューア">
  <p class="eyebrow">Mobile lesson viewer</p>
  <h1>英語教材</h1>
  <p class="lead">
    E001〜E234をスマホで読みやすく見るための閲覧専用ビューアです。問題・英作文・解答解説はGitHub上のcanonical教材から表示します。
  </p>

  <a class="thinking-tools-entry" href="/thinking-tools/">
    <small>共通ガイド</small>
    <strong>思考ツール</strong>
    <span>問題を見たとき、何を考えるか迷ったらここを見る</span>
  </a>

  <section class="index-section accelerated-p1-section" aria-labelledby="accelerated-p1-heading">
    <div class="index-section-heading">
      <h2 id="accelerated-p1-heading">P1短縮ルート｜15回</h2>
      <p>
        P1の全42回を順番に消化せず、まずこの15回を進めます。Checkpointで詰まった技能だけ、全教材一覧から同Bundleの補修回へ戻ります。
      </p>
    </div>

    <div class="accelerated-route-list">
      {acceleratedP1.map((item) => (
        <a class="accelerated-route-item" href={"/" + item.lesson.slug + "/"}>
          <span class="accelerated-route-step">{String(item.step).padStart(2, "0")}</span>
          <span class="accelerated-route-main">
            <strong>{item.lesson.id}｜{item.lesson.title}</strong>
            <small>{item.focus}</small>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="index-section accelerated-p1-section" aria-labelledby="accelerated-p2-heading">
    <div class="index-section-heading">
      <h2 id="accelerated-p2-heading">P2短縮ルート｜30回</h2>
      <p>
        P2の全54回を順番に消化せず、この30回で構文・段落・複数資料・要約・60→80→90語Writingを通します。Checkpointで弱点が出た技能だけ補修回へ戻ります。
      </p>
    </div>

    <div class="accelerated-route-list">
      {acceleratedP2.map((item) => (
        <a class="accelerated-route-item" href={"/" + item.lesson.slug + "/"}>
          <span class="accelerated-route-step">{String(item.step).padStart(2, "0")}</span>
          <span class="accelerated-route-main">
            <strong>{item.lesson.id}｜{item.lesson.title}</strong>
            <small>{item.focus}</small>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="index-section accelerated-p1-section" aria-labelledby="accelerated-p3-heading">
    <div class="index-section-heading">
      <h2 id="accelerated-p3-heading">P3短縮ルート｜54回</h2>
      <p>
        P3は各Bundleを「重要な実戦技能2回＋Checkpoint 1回」に圧縮します。残り54回は、Checkpointで弱点が出た技能だけ補修します。
      </p>
    </div>

    <details class="bundle-group">
      <summary>
        <strong>54回のCore Routeを見る</strong>
        <span>E097–E204</span>
        <small>P3</small>
      </summary>
      <div class="accelerated-route-list">
        {acceleratedP3.map((item) => (
          <a class="accelerated-route-item" href={"/" + item.lesson.slug + "/"}>
            <span class="accelerated-route-step">{String(item.step).padStart(2, "0")}</span>
            <span class="accelerated-route-main">
              <strong>{item.lesson.id}｜{item.lesson.title}</strong>
              <small>{item.focus}</small>
            </span>
          </a>
        ))}
      </div>
    </details>
  </section>

  <section class="index-section" aria-labelledby="representative-heading">
    <div class="index-section-heading">
      <p class="eyebrow">Representative lessons</p>
      <h2 id="representative-heading">代表教材</h2>
      <p>形式ごとの表示を細かく調整した教材です。</p>
    </div>

    <div class="card-list">
      {representatives.map((lesson) => (
        <a class="lesson-card" href={"/" + lesson.slug + "/"}>
          <small>{lesson.minutes ? "目安" + lesson.minutes + "分" : lesson.phase}</small>
          <strong>{lesson.id}｜{lesson.title}</strong>
          <span>{lesson.phase} / {lesson.bundle}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="index-section all-lessons-section" aria-labelledby="all-lessons-heading">
    <div class="index-section-heading">
      <p class="eyebrow">E001–E234</p>
      <h2 id="all-lessons-heading">全教材</h2>
      <p>全234教材。bundleを開くと、その中の教材へ移動できます。</p>
    </div>

    <div class="bundle-list">
      {bundles.map((group, index) => (
        <details class="bundle-group" open={index === 0}>
          <summary>
            <strong>{group.bundle}</strong>
            <span>{group.lessons[0]?.id}–{group.lessons[group.lessons.length - 1]?.id}</span>
            <small>{group.lessons[0]?.phase}</small>
          </summary>
          <div class="bundle-lessons">
            {group.lessons.map((lesson) => (
              <a href={"/" + lesson.slug + "/"} class={lesson.representative ? "bundle-lesson representative" : "bundle-lesson"}>
                <span>{lesson.id}</span>
                <strong>{lesson.title}</strong>
                {lesson.representative && <small>代表</small>}
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <p class="note">
    このサイトは閲覧専用です。答案入力・ログイン・進捗保存はありません。
  </p>
</BaseLayout>
