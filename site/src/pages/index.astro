---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLessonCatalog } from "../lib/lesson-catalog.js";
import { P1_ACCELERATED_ROUTE } from "../data/p1-accelerated-route.js";
import { P2_ACCELERATED_ROUTE } from "../data/p2-accelerated-route.js";
import { P3_ACCELERATED_ROUTE } from "../data/p3-accelerated-route.js";
import { toLearnerLessonNumber } from "../lib/learner-text.js";

const lessons = getLessonCatalog();
const lessonById = new Map(lessons.map((lesson) => [lesson.id, lesson]));

function learnerFocus(focus = "") {
  return focus
    .replace(/^B\d{3}\s+Checkpoint｜/i, "チェック回｜")
    .replace(/^P\d\s+Final Checkpoint｜/i, "最終チェック｜")
    .replace(/^P\d\s+Final Gate｜/i, "最終チェック｜")
    .replace(/^P\d入口｜/i, "入口｜");
}

function learnerTitle(title = "") {
  return title
    .replace(/筑波P\d+\s+Final Gate/gi, "筑波 最終チェック")
    .replace(/P\d+\s+Bridge\s+\d+\s+Checkpoint/gi, "チェック回")
    .replace(/P\d+\s+Final Checkpoint/gi, "最終チェック")
    .replace(/P\d+\s+Final Gate/gi, "最終チェック")
    .replace(/B\d{3}\s+Checkpoint/gi, "チェック回")
    .replace(/Bundle\s+\d+\s+Checkpoint/gi, "チェック回")
    .replace(/P\d+入口/gi, "入口")
    .replace(/\bB\d{3}\b/gi, "")
    .replace(/\bP[1-4]\b/gi, "")
    .replace(/\s{2,}/g, " ")
    .replace(/｜\s*｜/g, "｜")
    .trim();
}

function lessonNumber(id = "") {
  return Number(String(id).replace(/^E/i, ""));
}

function bundleTopic(groupLessons) {
  const checkpointTitle = learnerTitle(groupLessons[groupLessons.length - 1]?.title ?? "");
  const topic = checkpointTitle
    .replace(/^(?:筑波\s+)?(?:チェック回|最終チェック)(?:判定)?\s*[｜:：]?\s*/i, "")
    .trim();
  return topic || learnerTitle(groupLessons[0]?.title ?? "");
}

function buildRoute(source) {
  return source
    .map((item, index) => ({
      ...item,
      step: index + 1,
      focus: learnerFocus(item.focus),
      lesson: lessonById.get(item.id)
    }))
    .filter((item) => item.lesson);
}

const foundationRoute = buildRoute(P1_ACCELERATED_ROUTE);
const structureRoute = buildRoute(P2_ACCELERATED_ROUTE);
const practiceRoute = buildRoute(P3_ACCELERATED_ROUTE);
const tsukubaRoute = lessons
  .filter((lesson) => Number(lesson.id.slice(1)) >= 205)
  .map((lesson, index) => ({
    step: index + 1,
    focus: `Day ${index + 1}`,
    lesson
  }));

const routes = [
  {
    id: "route-foundation",
    title: "文の論理をつくる",
    description: "比較・因果・主張を、英語の文として組み立てる",
    practice: "比較・因果・主張／語句の使い分け／短いWriting",
    goal: "理由→仕組み→具体例の筋道を、短い英文で最後まで通す",
    count: foundationRoute.length,
    range: "教材1〜42",
    route: foundationRoute
  },
  {
    id: "route-structure",
    title: "まとまりのある英文を書く",
    description: "文をつなぎ、段落・要約・自由英作文へ広げる",
    practice: "文の骨格／段落構成／要約／自由英作文",
    goal: "複数文をつないで、まとまりのある答案を自力で作る",
    count: structureRoute.length,
    range: "教材43〜96",
    route: structureRoute
  },
  {
    id: "route-practice",
    title: "資料を読み取って書く",
    description: "初見の文章・図表から必要な情報を選び、答案を作る",
    practice: "初見文章・図表／情報選択／要約／判断・提案・評価",
    goal: "資料を根拠にして、読み取りから英作文まで一続きで処理する",
    count: practiceRoute.length,
    range: "教材97〜204",
    route: practiceRoute
  },
  {
    id: "route-tsukuba",
    title: "筑波大形式で仕上げる",
    description: "過去問形式で、時間内に読み・考え・書く",
    practice: "長文読解／語句整序／記述／自由英作文／時間配分",
    goal: "本番の順序と時間配分で、最後まで答案を完成させる",
    count: tsukubaRoute.length,
    range: "教材205〜234",
    route: tsukubaRoute
  }
];

const coreLessonIds = new Set(
  routes.flatMap((route) => route.route.map((item) => item.lesson.id))
);

const bundles = [...new Set(lessons.map((lesson) => lesson.bundle))].map((bundle) => {
  const groupLessons = lessons.filter((lesson) => lesson.bundle === bundle);
  const firstNumber = lessonNumber(groupLessons[0]?.id);
  const lastNumber = lessonNumber(groupLessons[groupLessons.length - 1]?.id);
  return {
    lessons: groupLessons,
    range: `教材${firstNumber}〜${lastNumber}`,
    topic: bundleTopic(groupLessons)
  };
});

const additionalBundles = bundles
  .map((group) => ({
    ...group,
    lessons: group.lessons.filter((lesson) => !coreLessonIds.has(lesson.id))
  }))
  .filter((group) => group.lessons.length > 0);

const additionalLessonCount = additionalBundles.reduce(
  (sum, group) => sum + group.lessons.length,
  0
);
---

<BaseLayout title="自由英作文｜教材ビューア">
  <p class="eyebrow">自由英作文</p>
  <h1>学習を始める</h1>

  <section class="entry-secondary" aria-label="教材を開く">
    <form class="lesson-jump-form" id="lesson-jump-form">
      <label for="lesson-jump-input">
        <strong>教材番号から開く</strong>
      </label>
      <div class="lesson-jump-controls">
        <input
          id="lesson-jump-input"
          name="lesson"
          inputmode="text"
          autocomplete="off"
          placeholder="例：86"
          aria-describedby="lesson-jump-help"
        />
        <button type="submit">開く</button>
      </div>
      <small id="lesson-jump-help">教材1〜234</small>
      <p class="lesson-jump-error" id="lesson-jump-error" role="alert" hidden></p>
    </form>

    <a class="entry-secondary-link" href="/e205/">
      <strong>筑波大対策</strong>
      <span>教材205から始める</span>
    </a>
  </section>

  <a class="thinking-tools-entry compact-thinking-tools-entry" href="/thinking-tools/">
    <small>困ったとき</small>
    <strong>思考ツールを見る</strong>
    <span>何を考えればよいか分からないときの共通ガイド</span>
  </a>

  <section class="index-section core-routes-section" aria-labelledby="core-routes-heading">
    <div class="index-section-heading">
      <p class="eyebrow">通常ルート</p>
      <h2 id="core-routes-heading">4段階で仕上げる</h2>
      <p>今の段階を開くと、通常ルートで進める教材だけが表示されます。</p>
    </div>

    <div class="core-route-stack">
      {routes.map((route, index) => (
        <details class="core-route-details" id={route.id}>
          <summary>
            <span class="core-route-stage" aria-hidden="true">{index + 1}</span>
            <span class="core-route-summary-main">
              <strong>{route.title}</strong>
              <small class="core-route-description">{route.description}</small>
              <span class="core-route-summary-points">
                <span><b>練習</b>{route.practice}</span>
                <span><b>到達</b>{route.goal}</span>
              </span>
            </span>
            <span class="core-route-summary-meta">
              <strong>通常ルート {route.count}回</strong>
              <small>{route.range}</small>
            </span>
          </summary>
          <div class="accelerated-route-list">
            {route.route.map((item) => (
              <a class="accelerated-route-item" href={"/" + item.lesson.slug + "/"}>
                <span class="accelerated-route-step">{String(item.step).padStart(2, "0")}</span>
                <span class="accelerated-route-main">
                  <strong>{toLearnerLessonNumber(item.lesson.id)}｜{learnerTitle(item.lesson.title)}</strong>
                  <small>{item.focus}</small>
                </span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="index-section repair-section" aria-label="追加練習と全教材">
    <details class="repair-catalog additional-practice-catalog">
      <summary>
        <span>
          <small>苦手な内容をもう少し練習したいとき</small>
          <strong>追加練習を探す</strong>
        </span>
        <span>{additionalLessonCount}教材</span>
      </summary>
      <div class="repair-catalog-body">
        <p>
          通常の学習ルート以外の練習教材です。チェック回などで苦手が見つかったときに、内容を見て必要なものだけ選びます。
        </p>

        <div class="bundle-list">
          {additionalBundles.map((group) => (
            <details class="bundle-group">
              <summary>
                <strong>{group.topic}</strong>
                <span>{group.range}｜{group.lessons.length}教材</span>
              </summary>
              <div class="bundle-lessons">
                {group.lessons.map((lesson) => (
                  <a href={"/" + lesson.slug + "/"} class="bundle-lesson">
                    <span>{toLearnerLessonNumber(lesson.id)}</span>
                    <strong>{learnerTitle(lesson.title)}</strong>
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      </div>
    </details>

    <details class="repair-catalog all-materials-catalog">
      <summary>
        <span>
          <small>番号や題名から直接探したいとき</small>
          <strong>全教材を見る</strong>
        </span>
        <span>教材1〜234</span>
      </summary>
      <div class="repair-catalog-body">
        <p>
          全234教材を番号順に確認できます。通常は上の学習段階か追加練習から選べば十分です。
        </p>

        <div class="bundle-list">
          {bundles.map((group) => (
            <details class="bundle-group">
              <summary>
                <strong>{group.topic}</strong>
                <span>{group.range}</span>
              </summary>
              <div class="bundle-lessons">
                {group.lessons.map((lesson) => (
                  <a href={"/" + lesson.slug + "/"} class="bundle-lesson">
                    <span>{toLearnerLessonNumber(lesson.id)}</span>
                    <strong>{learnerTitle(lesson.title)}</strong>
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      </div>
    </details>
  </section>

  <p class="note">
    閲覧専用です。答案入力・ログイン・進捗保存はありません。
  </p>

  <script is:inline>
    (() => {
      const form = document.getElementById("lesson-jump-form");
      const input = document.getElementById("lesson-jump-input");
      const error = document.getElementById("lesson-jump-error");
      if (!form || !input || !error) return;

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const raw = String(input.value || "").trim().toUpperCase();
        const normalized = raw.match(/^E?\s*0*(\d{1,3})$/);
        const number = normalized ? Number(normalized[1]) : NaN;

        if (!Number.isInteger(number) || number < 1 || number > 234) {
          error.textContent = "1〜234の教材番号を入力してください";
          error.hidden = false;
          input.focus();
          return;
        }

        error.hidden = true;
        window.location.href = "/e" + String(number).padStart(3, "0") + "/";
      });
    })();
  </script>
</BaseLayout>
