---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLessonCatalog } from "../lib/lesson-catalog.js";
import { P1_ACCELERATED_ROUTE } from "../data/p1-accelerated-route.js";
import { P2_ACCELERATED_ROUTE } from "../data/p2-accelerated-route.js";
import { P3_ACCELERATED_ROUTE } from "../data/p3-accelerated-route.js";

const lessons = getLessonCatalog();
const lessonById = new Map(lessons.map((lesson) => [lesson.id, lesson]));

function learnerFocus(focus = "") {
  return focus
    .replace(/^B\d{3}\s+Checkpoint｜/i, "チェック回｜")
    .replace(/^P\d\s+Final Checkpoint｜/i, "最終チェック｜")
    .replace(/^P\d\s+Final Gate｜/i, "最終チェック｜")
    .replace(/^P\d入口｜/i, "入口｜");
}

function learnerTitle(title = "") {
  return title
    .replace(/筑波P\d+\s+Final Gate/gi, "筑波 最終チェック")
    .replace(/P\d+\s+Bridge\s+\d+\s+Checkpoint/gi, "チェック回")
    .replace(/P\d+\s+Final Checkpoint/gi, "最終チェック")
    .replace(/P\d+\s+Final Gate/gi, "最終チェック")
    .replace(/B\d{3}\s+Checkpoint/gi, "チェック回")
    .replace(/Bundle\s+\d+\s+Checkpoint/gi, "チェック回")
    .replace(/P\d+入口/gi, "入口")
    .replace(/\bB\d{3}\b/gi, "")
    .replace(/\bP[1-4]\b/gi, "")
    .replace(/\s{2,}/g, " ")
    .replace(/｜\s*｜/g, "｜")
    .trim();
}

function buildRoute(source) {
  return source
    .map((item, index) => ({
      ...item,
      step: index + 1,
      focus: learnerFocus(item.focus),
      lesson: lessonById.get(item.id)
    }))
    .filter((item) => item.lesson);
}

const foundationRoute = buildRoute(P1_ACCELERATED_ROUTE);
const structureRoute = buildRoute(P2_ACCELERATED_ROUTE);
const practiceRoute = buildRoute(P3_ACCELERATED_ROUTE);
const tsukubaRoute = lessons
  .filter((lesson) => Number(lesson.id.slice(1)) >= 205)
  .map((lesson, index) => ({
    step: index + 1,
    focus: `Day ${index + 1}`,
    lesson
  }));

const routes = [
  {
    id: "route-foundation",
    title: "文の論理をつくる",
    description: "比較・因果・主張を、英語の文として組み立てる",
    count: foundationRoute.length,
    range: "E001–E042",
    route: foundationRoute
  },
  {
    id: "route-structure",
    title: "まとまりのある英文を書く",
    description: "文をつなぎ、段落・要約・自由英作文へ広げる",
    count: structureRoute.length,
    range: "E043–E096",
    route: structureRoute
  },
  {
    id: "route-practice",
    title: "資料を読み取って書く",
    description: "初見の文章・図表から必要な情報を選び、答案を作る",
    count: practiceRoute.length,
    range: "E097–E204",
    route: practiceRoute
  },
  {
    id: "route-tsukuba",
    title: "筑波大形式で仕上げる",
    description: "過去問形式で、時間内に読み・考え・書く",
    count: tsukubaRoute.length,
    range: "E205–E234",
    route: tsukubaRoute
  }
];

const bundles = [...new Set(lessons.map((lesson) => lesson.bundle))].map((bundle) => {
  const groupLessons = lessons.filter((lesson) => lesson.bundle === bundle);
  return {
    lessons: groupLessons,
    range: `${groupLessons[0]?.id}–${groupLessons[groupLessons.length - 1]?.id}`
  };
});
---

<BaseLayout title="自由英作文｜教材ビューア">
  <p class="eyebrow">自由英作文</p>
  <h1>学習を始める</h1>

  <section class="entry-secondary" aria-label="教材を開く">
    <form class="lesson-jump-form" id="lesson-jump-form">
      <label for="lesson-jump-input">
        <strong>教材番号から開く</strong>
      </label>
      <div class="lesson-jump-controls">
        <input
          id="lesson-jump-input"
          name="lesson"
          inputmode="text"
          autocomplete="off"
          placeholder="例：E086"
          aria-describedby="lesson-jump-help"
        />
        <button type="submit">開く</button>
      </div>
      <small id="lesson-jump-help">E001〜E234</small>
      <p class="lesson-jump-error" id="lesson-jump-error" role="alert" hidden></p>
    </form>

    <a class="entry-secondary-link" href="/e205/">
      <strong>筑波大対策</strong>
      <span>E205から始める</span>
    </a>
  </section>

  <a class="thinking-tools-entry compact-thinking-tools-entry" href="/thinking-tools/">
    <small>困ったとき</small>
    <strong>思考ツールを見る</strong>
    <span>何を考えればよいか分からないときの共通ガイド</span>
  </a>

  <section class="index-section core-routes-section" aria-labelledby="core-routes-heading">
    <div class="index-section-heading">
      <p class="eyebrow">教材一覧</p>
      <h2 id="core-routes-heading">学習段階から教材を開く</h2>
      <p>今取り組む段階だけ開けば大丈夫です。</p>
    </div>

    <div class="core-route-stack">
      {routes.map((route) => (
        <details class="core-route-details" id={route.id}>
          <summary>
            <span class="core-route-summary-main">
              <strong>{route.title}</strong>
              <small>{route.description}</small>
            </span>
            <span class="core-route-summary-meta">{route.count}回｜{route.range}</span>
          </summary>
          <div class="accelerated-route-list">
            {route.route.map((item) => (
              <a class="accelerated-route-item" href={"/" + item.lesson.slug + "/"}>
                <span class="accelerated-route-step">{String(item.step).padStart(2, "0")}</span>
                <span class="accelerated-route-main">
                  <strong>{item.lesson.id}｜{learnerTitle(item.lesson.title)}</strong>
                  <small>{item.focus}</small>
                </span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="index-section repair-section" aria-labelledby="repair-heading">
    <details class="repair-catalog">
      <summary>
        <span>
          <small>必要なときだけ</small>
          <strong id="repair-heading">補修・全教材</strong>
        </span>
        <span>E001–E234</span>
      </summary>
      <div class="repair-catalog-body">
        <p>
          チェック回で弱点が見つかったときに使います。全234教材を最初から順番に消化する必要はありません。
        </p>

        <div class="bundle-list">
          {bundles.map((group) => (
            <details class="bundle-group">
              <summary>
                <strong>{group.range}</strong>
                <span>{group.lessons.length}教材</span>
              </summary>
              <div class="bundle-lessons">
                {group.lessons.map((lesson) => (
                  <a href={"/" + lesson.slug + "/"} class="bundle-lesson">
                    <span>{lesson.id}</span>
                    <strong>{learnerTitle(lesson.title)}</strong>
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      </div>
    </details>
  </section>

  <p class="note">
    閲覧専用です。答案入力・ログイン・進捗保存はありません。
  </p>

  <script is:inline>
    (() => {
      const form = document.getElementById("lesson-jump-form");
      const input = document.getElementById("lesson-jump-input");
      const error = document.getElementById("lesson-jump-error");
      if (!form || !input || !error) return;

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const raw = String(input.value || "").trim().toUpperCase();
        const normalized = raw.match(/^E?\s*0*(\d{1,3})$/);
        const number = normalized ? Number(normalized[1]) : NaN;

        if (!Number.isInteger(number) || number < 1 || number > 234) {
          error.textContent = "E001〜E234の教材番号を入力してください";
          error.hidden = false;
          input.focus();
          return;
        }

        error.hidden = true;
        window.location.href = "/e" + String(number).padStart(3, "0") + "/";
      });
    })();
  </script>
</BaseLayout>
