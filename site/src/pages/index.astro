---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLessonCatalog } from "../lib/lesson-catalog.js";

const lessons = getLessonCatalog();
const representatives = lessons.filter((lesson) => lesson.representative);
const bundles = [...new Set(lessons.map((lesson) => lesson.bundle))].map((bundle) => ({
  bundle,
  lessons: lessons.filter((lesson) => lesson.bundle === bundle)
}));
---

<BaseLayout title="英語教材｜スマホビューア">
  <p class="eyebrow">Mobile lesson viewer</p>
  <h1>英語教材</h1>
  <p class="lead">
    E001〜E234をスマホで読みやすく見るための閲覧専用ビューアです。問題・英作文・解答解説はGitHub上のcanonical教材から表示します。
  </p>

  <a class="thinking-tools-entry" href="/thinking-tools/">
    <small>共通ガイド</small>
    <strong>思考ツール</strong>
    <span>問題を見たとき、何を考えるか迷ったらここを見る</span>
  </a>

  <section class="index-section" aria-labelledby="representative-heading">
    <div class="index-section-heading">
      <p class="eyebrow">Representative lessons</p>
      <h2 id="representative-heading">代表教材</h2>
      <p>形式ごとの表示を細かく調整した教材です。</p>
    </div>

    <div class="card-list">
      {representatives.map((lesson) => (
        <a class="lesson-card" href={"/" + lesson.slug + "/"}>
          <small>{lesson.minutes ? "目安" + lesson.minutes + "分" : lesson.phase}</small>
          <strong>{lesson.id}｜{lesson.title}</strong>
          <span>{lesson.phase} / {lesson.bundle}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="index-section all-lessons-section" aria-labelledby="all-lessons-heading">
    <div class="index-section-heading">
      <p class="eyebrow">E001–E234</p>
      <h2 id="all-lessons-heading">全教材</h2>
      <p>全234教材。bundleを開くと、その中の教材へ移動できます。</p>
    </div>

    <div class="bundle-list">
      {bundles.map((group, index) => (
        <details class="bundle-group" open={index === 0}>
          <summary>
            <strong>{group.bundle}</strong>
            <span>{group.lessons[0]?.id}–{group.lessons[group.lessons.length - 1]?.id}</span>
            <small>{group.lessons[0]?.phase}</small>
          </summary>
          <div class="bundle-lessons">
            {group.lessons.map((lesson) => (
              <a href={"/" + lesson.slug + "/"} class={lesson.representative ? "bundle-lesson representative" : "bundle-lesson"}>
                <span>{lesson.id}</span>
                <strong>{lesson.title}</strong>
                {lesson.representative && <small>代表</small>}
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <p class="note">
    このサイトは閲覧専用です。答案入力・ログイン・進捗保存はありません。
  </p>
</BaseLayout>
