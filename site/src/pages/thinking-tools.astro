---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  thinkingToolGroups,
  thinkingTools,
  thinkingRoutine,
  thinkingQuickRoutes
} from "../data/thinking-tools.js";

const toolById = new Map(thinkingTools.map((tool) => [tool.id, tool]));
---

<BaseLayout
  title="問題の考え方｜自由英作文"
  description="初見問題で止まったときに、何を答え、何を根拠にし、どう答案へつなぐかを確認するページ"
>
  <article class="thinking-tools-page">
    <header class="thinking-tools-header">
      <p class="eyebrow">問題で迷ったら</p>
      <h1>問題の考え方</h1>
      <p class="lead">
        覚える用語集ではありません。初見問題で手が止まったときに、
        「次に何を考えるか」を決めるためのページです。
      </p>
    </header>

    <section class="thinking-routine" aria-labelledby="thinking-routine-heading">
      <header>
        <p class="eyebrow">まずこれだけ</p>
        <h2 id="thinking-routine-heading">どの問題でも、5つの順番で考える</h2>
        <p>全部のツールを使う必要はありません。まずこの順番に戻れば十分です。</p>
      </header>
      <ol class="thinking-routine-list">
        {thinkingRoutine.map((item) => (
          <li>
            <span>{item.step}</span>
            <div>
              <strong>{item.title}</strong>
              <p>{item.prompt}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="thinking-stuck" aria-labelledby="thinking-stuck-heading">
      <header>
        <p class="eyebrow">今どこで止まった？</p>
        <h2 id="thinking-stuck-heading">困り方から開く</h2>
        <p>自分の詰まり方に近いものだけ開いてください。</p>
      </header>

      <div class="thinking-stuck-list">
        {thinkingQuickRoutes.map((route) => (
          <details class="thinking-stuck-card" id={route.id}>
            <summary>
              <span>
                <strong>{route.title}</strong>
                <small>{route.lead}</small>
              </span>
            </summary>
            <ol>
              {route.toolIds.map((toolId) => {
                const tool = toolById.get(toolId);
                return tool ? (
                  <li>
                    <strong>{tool.label}</strong>
                    <span>{tool.question}</span>
                  </li>
                ) : null;
              })}
            </ol>
          </details>
        ))}
      </div>
    </section>

    <details class="thinking-tools-library">
      <summary>
        <span>
          <small>必要なときだけ</small>
          <strong>考え方を全部見る</strong>
        </span>
        <span>{thinkingTools.length}項目</span>
      </summary>

      <div class="thinking-tools-library-body">
        <p class="thinking-tools-library-intro">
          同じ考え方を別テーマへ持ち運ぶための一覧です。問題を解く前に暗記する必要はありません。
        </p>

        <nav class="thinking-tools-index" aria-label="考え方の分類">
          {thinkingToolGroups.map((group) => (
            <a href={"#" + group.id}>{group.title}</a>
          ))}
        </nav>

        <div class="thinking-tool-groups">
          {thinkingToolGroups.map((group) => (
            <section class="thinking-tool-group" id={group.id}>
              <header>
                <h2>{group.title}</h2>
                <p>{group.description}</p>
              </header>

              <div class="thinking-tool-list">
                {group.tools.map((tool) => (
                  <article class="thinking-tool-card" id={tool.id}>
                    <div class="thinking-tool-card-head">
                      <div>
                        <h3>{tool.label}</h3>
                        <span>{tool.english}</span>
                      </div>
                    </div>
                    <p>{tool.question}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </details>

    <nav class="nav-row" aria-label="ナビゲーション">
      <a class="nav-link" href="/">トップへ戻る</a>
    </nav>
  </article>
</BaseLayout>
